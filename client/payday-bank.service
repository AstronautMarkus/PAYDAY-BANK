[Unit]
Description=PAYDAY BANK Flask client (gunicorn)
After=network.target

[Service]
Type=notify
User=astronautmarkus
Group=astronautmarkus

WorkingDirectory=/var/www/payday-bank.astronautmarkus.dev/client
Environment="PATH=/var/www/payday-bank.astronautmarkus.dev/.venv/bin"
# Override the dev-only default from app/config.py — required in production.
Environment="BANK_SECRET_KEY=change-me"

ExecStart=/var/www/payday-bank.astronautmarkus.dev/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:5005 \
    wsgi:app

Restart=on-failure
RestartSec=5
# gunicorn/systemd manage the process lifecycle; do not pass gunicorn's own
# --daemon flag here, it would break Type=notify supervision.

[Install]
WantedBy=multi-user.target
