*> Data-access module for ACCOUNT-FILE (accounts.dat). Owns the SELECT
*> and the FD -- per COBOL rules, all I/O on a file must happen inside
*> the program that declares it -- and exposes it to callers through a
*> function-code interface, since COBOL has no operation overloading.
*>
*> LK-REPO-FUNCTION selects the operation:
*>   OPEN | CLOSE | READ | WRITE | REWRITE | START | READNEXT
*>
*> READ expects LK-ACCOUNT-NUMBER set by the caller; fills the rest of
*> LK-ACCOUNT-RECORD and sets LK-REPO-FOUND on success. WRITE/REWRITE
*> take the full record from the caller. START positions the cursor at
*> the first key; READNEXT advances it and fills LK-ACCOUNT-RECORD.
*> LK-REPO-EOF is only meaningful after START/READNEXT.
IDENTIFICATION DIVISION.
PROGRAM-ID. ACCOUNT-REPOSITORY.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCOUNT-FILE ASSIGN TO "accounts.dat"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS FD-ACCOUNT-NUMBER
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD  ACCOUNT-FILE.
COPY "account-record.cpy".

WORKING-STORAGE SECTION.
01  WS-FILE-STATUS          PIC XX.

LINKAGE SECTION.
01  LK-REPO-FUNCTION        PIC X(10).
COPY "account-record.cpy"
    REPLACING ==ACCOUNT-RECORD==    BY ==LK-ACCOUNT-RECORD==
              ==FD-ACCOUNT-NUMBER== BY ==LK-ACCOUNT-NUMBER==
              ==FD-OWNER-NAME==     BY ==LK-OWNER-NAME==
              ==FD-BALANCE==        BY ==LK-BALANCE==.
01  LK-REPO-FOUND           PIC X.
01  LK-REPO-EOF             PIC X.

PROCEDURE DIVISION USING BY REFERENCE LK-REPO-FUNCTION
                          BY REFERENCE LK-ACCOUNT-RECORD
                          BY REFERENCE LK-REPO-FOUND
                          BY REFERENCE LK-REPO-EOF.
MAIN-ACCOUNT-REPOSITORY.
    MOVE "N" TO LK-REPO-FOUND
    MOVE "N" TO LK-REPO-EOF
    EVALUATE LK-REPO-FUNCTION
        WHEN "OPEN"     PERFORM OPEN-ACCOUNT-FILE
        WHEN "CLOSE"    PERFORM CLOSE-ACCOUNT-FILE
        WHEN "READ"     PERFORM READ-ACCOUNT-BY-KEY
        WHEN "WRITE"    PERFORM WRITE-ACCOUNT
        WHEN "REWRITE"  PERFORM REWRITE-ACCOUNT
        WHEN "START"    PERFORM START-ACCOUNT-SCAN
        WHEN "READNEXT" PERFORM READ-NEXT-ACCOUNT
        WHEN OTHER      CONTINUE
    END-EVALUATE
    GOBACK.

OPEN-ACCOUNT-FILE.
    *> Auto-creates accounts.dat if it does not exist yet (file status
    *> "35"), same behavior as the original monolithic MAIN-PARAGRAPH.
    OPEN I-O ACCOUNT-FILE
    IF WS-FILE-STATUS = "35"
        CLOSE ACCOUNT-FILE
        OPEN OUTPUT ACCOUNT-FILE
        CLOSE ACCOUNT-FILE
        OPEN I-O ACCOUNT-FILE
    END-IF.

CLOSE-ACCOUNT-FILE.
    CLOSE ACCOUNT-FILE.

READ-ACCOUNT-BY-KEY.
    MOVE LK-ACCOUNT-NUMBER TO FD-ACCOUNT-NUMBER
    READ ACCOUNT-FILE
        INVALID KEY
            MOVE "N" TO LK-REPO-FOUND
        NOT INVALID KEY
            MOVE ACCOUNT-RECORD TO LK-ACCOUNT-RECORD
            MOVE "Y" TO LK-REPO-FOUND
    END-READ.

WRITE-ACCOUNT.
    MOVE LK-ACCOUNT-RECORD TO ACCOUNT-RECORD
    WRITE ACCOUNT-RECORD
    IF WS-FILE-STATUS = "00"
        MOVE "Y" TO LK-REPO-FOUND
    ELSE
        MOVE "N" TO LK-REPO-FOUND
    END-IF.

REWRITE-ACCOUNT.
    MOVE LK-ACCOUNT-RECORD TO ACCOUNT-RECORD
    REWRITE ACCOUNT-RECORD
    IF WS-FILE-STATUS = "00"
        MOVE "Y" TO LK-REPO-FOUND
    ELSE
        MOVE "N" TO LK-REPO-FOUND
    END-IF.

START-ACCOUNT-SCAN.
    MOVE ZEROS TO FD-ACCOUNT-NUMBER
    START ACCOUNT-FILE KEY IS GREATER THAN OR EQUAL FD-ACCOUNT-NUMBER
        INVALID KEY
            MOVE "Y" TO LK-REPO-EOF
    END-START.

READ-NEXT-ACCOUNT.
    READ ACCOUNT-FILE NEXT RECORD
        AT END
            MOVE "Y" TO LK-REPO-EOF
        NOT AT END
            MOVE ACCOUNT-RECORD TO LK-ACCOUNT-RECORD
    END-READ.

END PROGRAM ACCOUNT-REPOSITORY.
